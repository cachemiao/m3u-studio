# 全新安装无需创建 .env。账号在首次打开网页时设置。
# 这两项仅用于 v0.1 旧账号的一次迁移；已有网页账号后不会覆盖。
ADMIN_USER=admin
ADMIN_PASSWORD=

# Optional advanced restrictions; leave empty for public and home-network IPTV.
# Nonempty NETWORKS is a strict allowlist, including public targets.
# Import and source checks are independent; sensitive targets remain blocked.
# Example: SOURCE_ALLOWED_NETWORKS=192.168.1.20/32
IMPORT_ALLOWED_NETWORKS=
IMPORT_ALLOWED_PORTS=
SOURCE_ALLOWED_NETWORKS=
SOURCE_ALLOWED_PORTS=
